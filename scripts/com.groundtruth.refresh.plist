<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template (macOS) for the weekly refresh agent.

  This is how "an agent that does weekly work" actually gets scheduled on a Mac
  or a Mac mini you leave running. On Linux, use cron or a systemd timer instead
  (see docs/02-weekly-agent.md).

  Install:
    1. Edit the absolute paths below to your checkout.
    2. cp scripts/com.groundtruth.refresh.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.groundtruth.refresh.plist
  Inspect:
    launchctl list | grep groundtruth
    tail -f /ABSOLUTE/PATH/TO/groundtruth/logs/refresh/launchd.out
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.groundtruth.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/ABSOLUTE/PATH/TO/groundtruth/scripts/refresh_pipeline.sh</string>
        <string>--write</string>
        <string>--open-pr</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/groundtruth</string>

    <!-- Weekly: Mondays at 03:30. (Weekday 1 = Monday.) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/groundtruth/logs/refresh/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/groundtruth/logs/refresh/launchd.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
