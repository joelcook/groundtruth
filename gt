#!/usr/bin/env python3
"""groundtruth launcher. Just run ./gt (Windows: py gt).

First run: creates .venv/ next to this file and installs groundtruth into it
(about a minute). After that it starts instantly. Needs Python 3.10+.
"""
import hashlib
import os
import subprocess
import sys
import venv
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV = ROOT / ".venv"
PY = VENV / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
STAMP = VENV / ".groundtruth-installed"


def deps_hash() -> str:
    return hashlib.sha256((ROOT / "pyproject.toml").read_bytes()).hexdigest()


def installed_ok() -> bool:
    return PY.exists() and STAMP.exists() and STAMP.read_text().strip() == deps_hash()


def install() -> None:
    if sys.version_info < (3, 10):
        sys.exit(f"groundtruth needs Python 3.10 or newer (this is {sys.version.split()[0]}). "
                 "Install one from python.org, then run it, e.g.: python3.12 gt")
    if not PY.exists():
        print("groundtruth: first run, setting up .venv/ (one time, about a minute)...", file=sys.stderr)
        venv.EnvBuilder(with_pip=True).create(VENV)
    print("groundtruth: installing dependencies...", file=sys.stderr)
    subprocess.check_call([str(PY), "-m", "pip", "install", "-q", "--disable-pip-version-check", "--upgrade", "pip"])
    subprocess.check_call([str(PY), "-m", "pip", "install", "-q", "--disable-pip-version-check", "-e", str(ROOT)])
    STAMP.write_text(deps_hash())


if __name__ == "__main__":
    if Path(sys.executable).resolve() != PY.resolve() or not installed_ok():
        if not installed_ok():
            try:
                install()
            except subprocess.CalledProcessError as exc:
                sys.exit(f"groundtruth: install failed ({exc}). Check your internet connection and retry ./gt")
        os.execv(str(PY), [str(PY), "-m", "groundtruth", *sys.argv[1:]])
    from groundtruth.cli import main
    raise SystemExit(main())
