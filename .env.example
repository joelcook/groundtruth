# Copy to .env (gitignored) and fill in what you need. Everything is optional:
# the demo, ./gt check, ./gt eval, ingest, and the server all run without keys.
#   load it with:  set -a; source .env; set +a

# ---- Claude: live evals, ./gt ask answers, ./gt compile --write, ./gt rewrite ----
# https://console.anthropic.com (set a monthly spend limit there too). For an
# unattended refresh host this is the simplest credential: it doesn't expire.
ANTHROPIC_API_KEY=
# GT_MODEL=claude-opus-5-5          # use the model your assistant runs on in production
# GT_JUDGE_MODEL=claude-opus-5-5    # grades narrative answers in live evals
# GT_EFFORT=medium

# ---- MCP server ----
# Require this key on every HTTP request (Authorization: Bearer <key>).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GT_MCP_API_KEY=
# GT_ALLOWED_HOSTS=mcp.example.org  # only needed when you serve without a key
# GT_CHAT=1                         # /chat: a web chat for your users (needs ANTHROPIC_API_KEY)
# GT_CHAT_PER_MINUTE=6              # questions per visitor per minute
# GT_CHAT_PER_DAY=2000              # questions per day, all visitors
# GT_MCP_HOST=127.0.0.1
# GT_MCP_PORT=8765

# ---- Live data updates for deployed servers (see docs/deploy.md) ----
# GT_DATA_URL=https://github.com/you/repo/releases/download/data-latest/groundtruth-data.tar.gz
# GT_DATA_TOKEN=                    # for a private URL
# GT_DATA_POLL_SECONDS=600

# ---- Search ----
# GT_SEARCH_BACKEND=scan            # scan (default) | semantic | auto
# GT_EMBEDDER=hashing               # voyage (needs VOYAGE_API_KEY and ./gt setup --voyage)

# ---- The refresh host and ./gt rewrite (see docs/operations.md) ----
# ./gt rewrite runs headless Claude Code (`claude -p`): with ANTHROPIC_API_KEY above
# (API billing), or on your Claude plan with a token from `claude setup-token`,
# pasted here. This file is gitignored; never commit either one.
CLAUDE_CODE_OAUTH_TOKEN=
# GT_REWRITE_MODEL=                 # default: the haiku alias if it's Haiku 5.5+, else sonnet
# GT_REWRITE_FALLBACK_MODEL=sonnet  # one retry, with the failed checks
# GT_REWRITE_CHECK_MODEL=sonnet     # reads the page beside its sources; "off" skips the claim check
# GT_REWRITE_MAX_PAGES=10           # pages per run
# GT_REWRITE_MAX_UTILIZATION=0.8    # past this share of any usage window, wait for it to reset
# GT_FACTS_MAX_CHANGE_SHARE=0.3     # a fact update changing more of the rows than this stops
# GT_LIVE_EVAL=1                    # 0: the autopilot skips its nightly live eval
# GT_REWRITE_QUIET_HOURS=02:40-03:50  # default: around GT_REFRESH_AT, set by ./gt host install
# GT_CLAUDE=/path/to/claude         # default: the claude on PATH

# GT_QUICK_REFRESH_SECONDS=7200     # re-capture the sources facts cite this often by day; 0 = off
# GT_HOST_WORKDIR=~/.cache/groundtruth   # where the host's worktrees live
# GT_WATCHDOG_URL=https://mcp.example.org/mcp   # alert when the deployed server runs old code

# Alerts always land in logs/host/alerts.log and then ALERTS.md. These are extra:
# GT_ALERT_EMAIL=you@example.org    # needs the `mail` command
# GT_ALERT_COMMAND='curl -s -d "$GT_ALERT_TITLE: $GT_ALERT_MESSAGE" ntfy.sh/your-topic'
