# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#   load with:  set -a; source .env; set +a

# ---- Claude API (only needed for live evals and LLM recompile) ----
# Get one at https://console.anthropic.com. Set a monthly spend cap there too,
# so a runaway loop can't drain the account.
ANTHROPIC_API_KEY=

# The eval model MUST mirror the model you actually run in production, or your
# eval signal is testing a different assistant than your users talk to. The
# judge is a stricter, separate model.
# EVAL_MODEL=claude-sonnet-4-6
# EVAL_JUDGE_MODEL=claude-opus-4-8
# RECOMPILE_MODEL=claude-opus-4-8

# ---- MCP server ----
# If set, every HTTP request must send Authorization: Bearer <key>
# (or x-ms-apikey: <key>). Leave unset for open local dev only.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GT_MCP_API_KEY=
# GT_MCP_HOST=127.0.0.1
# GT_MCP_PORT=8765

# ---- Retrieval backend ----
# scan = lexical scanner (default, zero deps). semantic = embeddings only.
# auto = blend both (needs an index: python scripts/build_index.py).
# GT_SEARCH_BACKEND=scan
# GT_EMBEDDER=hashing          # 'voyage' to use a real model (needs VOYAGE_API_KEY)
# VOYAGE_API_KEY=

# ---- Refresh agent ----
# A wiki page is "stale" when last_compiled is older than this many days.
# GT_STALE_DAYS=30
